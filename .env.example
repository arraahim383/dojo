# Optional: enables the Gemini coach ("Explain" buttons). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: enable the Gemini coach in a static build that has an /api/explain function
# VITE_GEMINI_COACH=1
# Optional: port (default 3000)
# PORT=3000

# Account sync. Create a Supabase project, then run supabase/migrations/20261110000000_user_progress.sql.
# These are public client values; row-level security protects each user's data. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: email verification and password reset return to this hosted app.
VITE_AUTH_REDIRECT_URL=https://dojo-omega-two.vercel.app
# Server-only: required for the in-app account deletion API. Never add a VITE_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# If using Vercel's Supabase Marketplace integration, SUPABASE_SECRET_KEY may be used instead.
# Keep it server-only; never add a VITE_ prefix.
SUPABASE_SECRET_KEY=
# Optional Vercel Marketplace variable name for the public key.
SUPABASE_PUBLISHABLE_KEY=
